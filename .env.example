# Copy this file to `.env` (which is git-ignored) and fill in the values you
# have. `.env` is loaded automatically by the docker-compose files and by
# backend/main.py (via python-dotenv) when running outside Docker.
#
# All keys are OPTIONAL — the tool runs without them; only the feature each key
# powers is disabled when its key is blank. Never commit the real `.env`.

# OpenAI — used by AI-assisted endpoints in backend/main.py
OPENAI_API_KEY=

# Anthropic — optional; preferred over OpenAI when set
ANTHROPIC_API_KEY=

# UK EPC (Energy Performance Certificate) API — UK building energy lookups.
# Register at https://epc.opendatacommunities.org/
UK_EPC_API_TOKEN=

# Lantmäteriet (Swedish national mapping) — address/geocoding lookups
LANTMATERIET_USER=
LANTMATERIET_PASSWORD=

# Västtrafik (Gothenburg public transit) — required for /api/vasttrafik/* endpoints
VASTTRAFIK_CLIENT_ID=
VASTTRAFIK_CLIENT_SECRET=

# Trafikverket (Swedish Transport Administration) — road/traffic data
TRAFIKVERKET_API_KEY=

# EPSM energy-simulation backend. The compose files set this for you when EPSM
# runs on the same host (docker-compose.epsm.yml); only override to point
# elsewhere.
# EPSM_BASE_URL=http://host.docker.internal:8010
