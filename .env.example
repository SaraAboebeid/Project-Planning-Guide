# Copy this file to `.env` (which is git-ignored) and fill in real values.
# `.env` is loaded automatically by docker-compose and by backend/main.py
# (via python-dotenv) when running outside Docker.

# OpenAI — used by AI-assisted endpoints in backend/main.py
OPENAI_API_KEY=

# Anthropic — optional; preferred over OpenAI when set
ANTHROPIC_API_KEY=

# Västtrafik (public transit API) — required for /api/vasttrafik/* endpoints
VASTTRAFIK_CLIENT_ID=
VASTTRAFIK_CLIENT_SECRET=
